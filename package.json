{
  "name": "@charonwwang/ui-spec",
  "version": "1.5.0",
  "description": "Install the UI Spec Codex skill and choose frontend components with exact bilingual terminology.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonwwang/ui-spec.git"
  },
  "homepage": "https://github.com/charonwwang/ui-spec#readme",
  "bugs": {
    "url": "https://github.com/charonwwang/ui-spec/issues"
  },
  "publishConfig": {
    "access": "public",
